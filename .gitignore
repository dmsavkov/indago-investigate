*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
.env/
.tmp/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
