# Optional environment for indago-investigate (public / package install).
# Copy to `.env` in the case root or set in the shell. None of these are
# required for examples/demo_case under default Views bind.

# Binding mode: views (default) | prefer_views | caseio (lab ops only)
# INDAGO_BIND=views

# Offline scorer Python (rare). Default: current interpreter when [score] is installed.
# INDAGO_SCORER_PYTHON=

# Lab-only: path to production-ml-lab (not needed for public demo)
# INDAGO_LAB_ROOT=
# INDAGO_ALLOW_LAB_DISCOVERY=0

# Shadow overfetch pool (off by default; do not enable for contact packs)
# INDAGO_ALLOW_OVERFETCH=0
